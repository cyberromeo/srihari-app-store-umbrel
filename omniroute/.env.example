# OmniRoute environment overrides for Umbrel.
#
# Copy this file to `.env` (in the same directory as docker-compose.yml) and
# edit the values. Any variable left unset here falls back to the inline
# `${VAR:-default}` defaults defined in docker-compose.yml.

# --- Web server ---------------------------------------------------------------
# Dashboard port
PORT=20128
DASHBOARD_PORT=20128

# API port
API_PORT=20129
API_HOST=0.0.0.0

# WebSocket port
LIVE_WS_PORT=20132
LIVE_WS_HOST=0.0.0.0

# Allowed origins for WebSocket connections (default * allows Umbrel proxy and IPs)
LIVE_WS_ALLOWED_ORIGINS=*

# --- Redis --------------------------------------------------------------------
REDIS_URL=redis://redis:6379
