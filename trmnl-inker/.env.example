# Inker environment overrides for Umbrel.
#
# Copy this file to `.env` (next to docker-compose.yml) and edit. Any variable
# left unset here falls back to the inline `${VAR:-default}` defaults defined in
# docker-compose.yml.
#
# IMPORTANT: Change ADMIN_PIN from the default 1111 for any real deployment.
# ADMIN_PIN must be quoted in any YAML file (leading zeros are stripped
# otherwise).

# --- Auth ---------------------------------------------------------------------
# Login PIN (string). Change me.
ADMIN_PIN="1111"

# --- Locale -------------------------------------------------------------------
TZ=UTC
DEFAULT_TIMEZONE=UTC