# Terminus environment overrides for Umbrel.
#
# Copy this file to `.env` (in the same directory as docker-compose.yml) and
# edit the values. The Umbrel manager may also generate/persist some of these
# for you on install. Any variable left unset here falls back to the inline
# `${VAR:-default}` defaults defined in docker-compose.yml.
#
# IMPORTANT: The inline defaults for APP_SECRET, DATABASE_PASSWORD and
# KEYVALUE_PASSWORD are insecure placeholders intended only so the stack boots
# standalone. Override them for any real deployment. If you change
# DATABASE_PASSWORD or KEYVALUE_PASSWORD after first boot, you must re-seed the
# corresponding volume (see upstream Docker troubleshooting docs).

# --- Web server ---------------------------------------------------------------
# Port the Hanami/Puma web server listens on (also Umbrel's exposed port).
HANAMI_PORT=2300

# Public URL the TRMNL device uses to reach this server. Under Umbrel the
# app_proxy exposes the app on the umbrella *.local URL, so set this to that
# URL (or your reverse-proxy hostname) once installed.
API_URI=http://localhost:2300

# Hanami session/cookie/CSRF secret. MUST be persistent across restarts and
# >= 64 chars (Hanami Settings enforces min_size: 64). Replace with a long
# random string, e.g. output of: ruby -e "puts SecureRandom.hex(40)"
APP_SECRET=replace_me_with_a_long_random_secret_at_least_64_characters_long_minimum

# Set to "true" on the web service only. When true, the container compiles
# assets and runs DB migrations before starting Puma. Leave true.
APP_SETUP=true

# --- PostgreSQL (database service) -------------------------------------------
DATABASE_USER=terminus
DATABASE_NAME=terminus
DATABASE_PASSWORD=replace_me_with_a_long_random_password
DATABASE_PORT=5432

# --- Valkey / Redis (keyvalue service) ----------------------------------------
KEYVALUE_DATABASE=0
KEYVALUE_PASSWORD=replace_me_with_a_long_random_password
KEYVALUE_PORT=6379