# VansRouter environment overrides for Umbrel.
#
# Copy this file to `.env` (in the same directory as docker-compose.yml, i.e.
# ~/umbrel/app-data/trmnl-vansrouter/ on the Umbrel host) and edit the values.
# The `app` service loads it via `env_file: .env`, so ANY variable documented in
# upstream's .env.example reaches the container — not just the ones below.
# Restart the app from the umbrelOS UI afterwards.
#
# Note the precedence: variables listed under `environment:` in
# docker-compose.yml win over this file. The ones written as ${VAR:-default}
# there read from this file; DATA_DIR, PORT, HOSTNAME, NODE_ENV and
# INITIAL_PASSWORD are packaging invariants and cannot be overridden here.

# --- Timezone -----------------------------------------------------------------
# Affects log timestamps and provider quota-reset windows.
TZ=UTC

# --- Headroom -----------------------------------------------------------------
# URL of the compression sidecar. Change only if you run Headroom elsewhere;
# point it at your own host with http://<lan-ip>:8787 if you remove the
# `headroom` service from docker-compose.yml.
HEADROOM_URL=http://headroom:8787

# --- API access ---------------------------------------------------------------
# Calls to /v1/* from other machines already require an API key you create under
# Endpoint & Key in the dashboard. Set this to true to also require one for
# calls made from inside the container.
REQUIRE_API_KEY=false

# Comma-separated hostnames trusted for public /v1/* access, for when you front
# the app with your own domain. Example: PUBLIC_API_HOSTS=ai.example.com
PUBLIC_API_HOSTS=

# --- Optional extras (uncomment as needed) ------------------------------------
#
#   # Verbose per-request logging. High volume; useful when debugging a provider.
#   ENABLE_REQUEST_LOGS=true
#   DEBUG=true
#
#   # Internal metrics collection (on by default upstream).
#   OBSERVABILITY_ENABLED=true
#
#   # Pin the JWT and API-key secrets instead of letting VansRouter generate and
#   # store them under /app/data. Only do this if you need the same keys to work
#   # across two installs — a plain reinstall keeps them automatically, and
#   # changing API_KEY_SECRET invalidates every API key already issued.
#   # Generate each with: openssl rand -hex 32
#   JWT_SECRET=
#   API_KEY_SECRET=
#
#   # Route upstream provider calls through a proxy (restricted regions).
#   HTTP_PROXY=http://127.0.0.1:7890
#   HTTPS_PROXY=http://127.0.0.1:7890
#   NO_PROXY=localhost,127.0.0.1,headroom
#
# Not usable in this package, regardless of what you set here:
# TAILSCALE_USE_HOST_SOCKET and the Cloudflare tunnel settings. VansRouter gates
# its tunnel, MCP and CLI-import endpoints to loopback callers, and every
# request arriving through Umbrel's app_proxy is a proxied one. Use umbrelOS's
# own remote access instead.
