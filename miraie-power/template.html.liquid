<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    html, body {
      width: 800px;
      height: 480px;
      font-family: 'Arial', sans-serif;
      background: white;
      color: black;
      overflow: hidden;
    }
    .container {
      width: 800px;
      height: 480px;
      display: flex;
      flex-direction: column;
      padding: 16px 24px;
    }
    .header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      border-bottom: 2px solid black;
      padding-bottom: 8px;
      margin-bottom: 12px;
    }
    .header h1 {
      font-size: 20px;
      font-weight: bold;
    }
    .header .date {
      font-size: 14px;
      color: #666;
    }
    .sections {
      display: flex;
      flex: 1;
      gap: 16px;
    }
    .section {
      flex: 1;
      display: flex;
      flex-direction: column;
    }
    .section-title {
      font-size: 13px;
      font-weight: bold;
      text-transform: uppercase;
      color: #888;
      margin-bottom: 8px;
      padding-bottom: 4px;
      border-bottom: 1px solid #ccc;
    }
    .big-value {
      font-size: 42px;
      font-weight: bold;
      line-height: 1.1;
    }
    .big-unit {
      font-size: 14px;
      color: #666;
      margin-top: 2px;
    }
    .sub-value {
      font-size: 16px;
      margin-top: 8px;
    }
    .sub-label {
      font-size: 11px;
      color: #888;
    }
    .bar-list {
      display: flex;
      flex-direction: column;
      gap: 4px;
      flex: 1;
    }
    .bar-row {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 12px;
    }
    .bar-label {
      width: 45px;
      text-align: right;
      font-weight: bold;
    }
    .bar-track {
      flex: 1;
      height: 14px;
      background: #eee;
      position: relative;
    }
    .bar-fill {
      height: 100%;
      background: black;
    }
    .bar-fill.red {
      background: #c00;
    }
    .bar-value {
      width: 45px;
      font-size: 11px;
      font-weight: bold;
    }
    .daily-chart {
      display: flex;
      align-items: flex-end;
      gap: 3px;
      flex: 1;
      padding-top: 8px;
    }
    .day-bar {
      flex: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 2px;
    }
    .day-bar-fill {
      width: 100%;
      background: black;
      min-height: 2px;
    }
    .day-bar-fill.red { background: #c00; }
    .day-bar-label {
      font-size: 8px;
      color: #666;
      margin-top: 4px;
    }
    .footer {
      border-top: 1px solid #ccc;
      padding-top: 4px;
      margin-top: 8px;
      font-size: 10px;
      color: #999;
      text-align: center;
    }
    .error {
      font-size: 12px;
      color: #c00;
      padding: 8px;
    }
  </style>
</head>
<body>
  <div class="container">
    <div class="header">
      <h1>MirAIe Power Consumption</h1>
      <div class="date">{{ "now" | date: "%b %d, %Y %H:%M" }}</div>
    </div>

    <div class="sections">
      <!-- Monthly: source_1 = [{"power": float, "month": "MMYYYY"}, ...] -->
      <div class="section">
        <div class="section-title">This Month</div>
        {% if source_1 %}
          {% assign monthly_total = 0 %}
          {% for item in source_1 %}
            {% if item.power %}{% assign monthly_total = monthly_total | plus: item.power %}{% endif %}
          {% endfor %}
          <div class="big-value">{{ monthly_total | round: 1 }}</div>
          <div class="big-unit">kWh (Jan-Jul 2026)</div>
          {% assign latest_month = source_1 | last %}
          {% if latest_month.power %}
            <div class="sub-value">{{ latest_month.power | round: 1 }} kWh</div>
            <div class="sub-label">Current month</div>
          {% endif %}
          {% assign max_month = 0 %}
          {% for item in source_1 %}
            {% if item.power > max_month %}{% assign max_month = item.power %}{% endif %}
          {% endfor %}
          <div class="bar-list" style="margin-top: 8px;">
            {% for item in source_1 %}
              {% if max_month > 0 %}
                {% assign month_pct = item.power | divided_by: max_month | times: 100 %}
              {% else %}
                {% assign month_pct = 0 %}
              {% endif %}
              {% assign month_label = item.month | slice: 0, 2 %}
              <div class="bar-row">
                <div class="bar-label">{{ month_label }}</div>
                <div class="bar-track">
                  <div class="bar-fill" style="width: {{ month_pct | round }}%"></div>
                </div>
                <div class="bar-value">{{ item.power | round: 1 }}</div>
              </div>
            {% endfor %}
          </div>
        {% else %}
          <div class="error">No data</div>
        {% endif %}
      </div>

      <!-- Weekly: source_2 = [{"power": float, "week": "DDMMYYYY"}, ...] -->
      <div class="section">
        <div class="section-title">Weekly</div>
        {% if source_2 %}
          {% assign week_max = 0 %}
          {% for item in source_2 %}
            {% if item.power > week_max %}{% assign week_max = item.power %}{% endif %}
          {% endfor %}
          <div class="bar-list">
            {% for item in source_2 %}
              {% if week_max > 0 %}
                {% assign week_pct = item.power | divided_by: week_max | times: 100 %}
              {% else %}
                {% assign week_pct = 0 %}
              {% endif %}
              {% assign week_label = item.week | slice: 0, 2 %}
              <div class="bar-row">
                <div class="bar-label">{{ week_label }}</div>
                <div class="bar-track">
                  <div class="bar-fill{% if item.power > 60 %} red{% endif %}" style="width: {{ week_pct | round }}%"></div>
                </div>
                <div class="bar-value">{{ item.power | round: 1 }}</div>
              </div>
            {% endfor %}
          </div>
        {% else %}
          <div class="error">No data</div>
        {% endif %}
      </div>

      <!-- Daily: source_3 = [{"power": float, "day": "DDMMYYYY"}, ...] -->
      <div class="section">
        <div class="section-title">Daily (7 days)</div>
        {% if source_3 %}
          {% assign daily_max = 0 %}
          {% for item in source_3 %}
            {% if item.power > daily_max %}{% assign daily_max = item.power %}{% endif %}
          {% endfor %}
          {% assign daily_threshold = daily_max | divided_by: 2 %}
          <div class="daily-chart">
            {% for item in source_3 %}
              {% if daily_max > 0 %}
                {% assign bar_h = item.power | divided_by: daily_max | times: 100 %}
              {% else %}
                {% assign bar_h = 0 %}
              {% endif %}
              {% assign dlabel = item.day | slice: 0, 2 %}
              <div class="day-bar">
                <div class="day-bar-fill{% if item.power > daily_threshold %} red{% endif %}" style="height: {{ bar_h | round }}%"></div>
                <div class="day-bar-label">{{ dlabel }}</div>
              </div>
            {% endfor %}
          </div>
        {% else %}
          <div class="error">No data</div>
        {% endif %}
      </div>
    </div>

    <div class="footer">
      Panasonic MirAIe &middot; Device: 36ff8e5467b2 &middot; Auto-refresh: {{ extension.interval | default: 15 }} min
    </div>
  </div>
</body>
</html>