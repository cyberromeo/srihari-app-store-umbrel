<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    html, body {
      width: 800px;
      height: 480px;
      font-family: 'Arial', sans-serif;
      background: white;
      color: black;
      overflow: hidden;
    }
    .container {
      width: 800px;
      height: 480px;
      display: flex;
      flex-direction: column;
      padding: 16px 24px;
    }
    .header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      border-bottom: 2px solid black;
      padding-bottom: 8px;
      margin-bottom: 12px;
    }
    .header h1 {
      font-size: 20px;
      font-weight: bold;
    }
    .header .date {
      font-size: 14px;
      color: #666;
    }
    .sections {
      display: flex;
      flex: 1;
      gap: 16px;
    }
    .section {
      flex: 1;
      display: flex;
      flex-direction: column;
    }
    .section-title {
      font-size: 13px;
      font-weight: bold;
      text-transform: uppercase;
      color: #888;
      margin-bottom: 8px;
      padding-bottom: 4px;
      border-bottom: 1px solid #ccc;
    }
    .big-value {
      font-size: 42px;
      font-weight: bold;
      line-height: 1.1;
    }
    .big-unit {
      font-size: 14px;
      color: #666;
      margin-top: 2px;
    }
    .bar-list {
      display: flex;
      flex-direction: column;
      gap: 4px;
      flex: 1;
    }
    .bar-row {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 12px;
    }
    .bar-label {
      width: 55px;
      text-align: right;
      font-weight: bold;
    }
    .bar-track {
      flex: 1;
      height: 14px;
      background: #eee;
      position: relative;
    }
    .bar-fill {
      height: 100%;
      background: black;
    }
    .bar-fill.red {
      background: #c00;
    }
    .bar-value {
      width: 50px;
      font-size: 11px;
      font-weight: bold;
    }
    .daily-chart {
      display: flex;
      align-items: flex-end;
      gap: 3px;
      flex: 1;
      padding-top: 8px;
    }
    .day-bar {
      flex: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 2px;
    }
    .day-bar-fill {
      width: 100%;
      background: black;
      min-height: 2px;
    }
    .day-bar-fill.red { background: #c00; }
    .day-bar-label {
      font-size: 8px;
      color: #666;
      transform: rotate(-45deg);
      transform-origin: center;
      white-space: nowrap;
      margin-top: 4px;
    }
    .footer {
      border-top: 1px solid #ccc;
      padding-top: 4px;
      margin-top: 8px;
      font-size: 10px;
      color: #999;
      text-align: center;
    }
    .error {
      font-size: 12px;
      color: #c00;
      padding: 8px;
    }
  </style>
</head>
<body>
  <div class="container">
    <div class="header">
      <h1>MirAIe Power Consumption</h1>
      <div class="date">{{ "now" | date: "%b %d, %Y %H:%M" }}</div>
    </div>

    <div class="sections">
      <!-- Monthly -->
      <div class="section">
        <div class="section-title">Monthly</div>
        {% if source_1 %}
          {% assign monthly = source_1 %}
          {% if monthly.power %}
            <div class="big-value">{{ monthly.power | round: 1 }}</div>
            <div class="big-unit">kWh</div>
          {% elsif monthly.consumption %}
            <div class="big-value">{{ monthly.consumption | round: 1 }}</div>
            <div class="big-unit">kWh</div>
          {% elsif monthly.total %}
            <div class="big-value">{{ monthly.total | round: 1 }}</div>
            <div class="big-unit">kWh</div>
          {% elsif monthly.data %}
            {% assign monthly_total = 0 %}
            {% for item in monthly.data %}
              {% if item.power %}{% assign monthly_total = monthly_total | plus: item.power %}{% elsif item.consumption %}{% assign monthly_total = monthly_total | plus: item.consumption %}{% elsif item.energy %}{% assign monthly_total = monthly_total | plus: item.energy %}{% endif %}
            {% endfor %}
            <div class="big-value">{{ monthly_total | round: 1 }}</div>
            <div class="big-unit">kWh total</div>
          {% else %}
            <div class="big-value">{{ monthly | round: 1 }}</div>
            <div class="big-unit">kWh</div>
          {% endif %}
        {% else %}
          <div class="error">No data</div>
        {% endif %}
      </div>

      <!-- Weekly -->
      <div class="section">
        <div class="section-title">Weekly</div>
        {% if source_2 %}
          {% assign weekly = source_2 %}
          {% if weekly.data %}
            {% assign weekly_items = weekly.data %}
          {% else %}
            {% assign weekly_items = weekly %}
          {% endif %}
          <div class="bar-list">
            {% for item in weekly_items limit: 6 %}
              {% assign power_val = 0 %}
              {% if item.power %}{% assign power_val = item.power %}{% elsif item.consumption %}{% assign power_val = item.consumption %}{% elsif item.energy %}{% assign power_val = item.energy %}{% elsif item.value %}{% assign power_val = item.value %}{% endif %}
              {% assign bar_pct = power_val | times: 1.0 %}
              {% if item.date %}
                {% assign label = item.date | slice: 0, 5 %}
              {% elsif item.day %}
                {% assign label = item.day %}
              {% elsif item.label %}
                {% assign label = item.label %}
              {% else %}
                {% assign label = forloop.index %}
              {% endif %}
              <!-- Max for scaling: assume 20 kWh as reasonable weekly range -->
              {% assign bar_width = power_val | divided_by: 20.0 | times: 100 %}
              {% if bar_width > 100 %}{% assign bar_width = 100 %}{% endif %}
              <div class="bar-row">
                <div class="bar-label">{{ label }}</div>
                <div class="bar-track">
                  <div class="bar-fill{% if power_val > 10 %} red{% endif %}" style="width: {{ bar_width | round }}%"></div>
                </div>
                <div class="bar-value">{{ power_val | round: 1 }}</div>
              </div>
            {% endfor %}
          </div>
        {% else %}
          <div class="error">No data</div>
        {% endif %}
      </div>

      <!-- Daily -->
      <div class="section">
        <div class="section-title">Daily (7 days)</div>
        {% if source_3 %}
          {% assign daily = source_3 %}
          {% if daily.data %}
            {% assign daily_items = daily.data %}
          {% else %}
            {% assign daily_items = daily %}
          {% endif %}
          <div class="daily-chart">
            {% assign daily_max = 0 %}
            {% for item in daily_items limit: 7 %}
              {% assign dv = 0 %}
              {% if item.power %}{% assign dv = item.power %}{% elsif item.consumption %}{% assign dv = item.consumption %}{% elsif item.energy %}{% assign dv = item.energy %}{% elsif item.value %}{% assign dv = item.value %}{% endif %}
              {% if dv > daily_max %}{% assign daily_max = dv %}{% endif %}
            {% endfor %}

            {% for item in daily_items limit: 7 %}
              {% assign dv = 0 %}
              {% if item.power %}{% assign dv = item.power %}{% elsif item.consumption %}{% assign dv = item.consumption %}{% elsif item.energy %}{% assign dv = item.energy %}{% elsif item.value %}{% assign dv = item.value %}{% endif %}
              {% if daily_max > 0 %}
                {% assign bar_h = dv | divided_by: daily_max | times: 100 %}
              {% else %}
                {% assign bar_h = 0 %}
              {% endif %}
              {% if item.date %}
                {% assign dlabel = item.date | slice: 0, 2 %}
              {% elsif item.day %}
                {% assign dlabel = item.day | slice: 0, 2 %}
              {% else %}
                {% assign dlabel = forloop.index %}
              {% endif %}
              <div class="day-bar">
                <div class="day-bar-fill{% if dv > daily_max | divided_by: 2 %} red{% endif %}" style="height: {{ bar_h | round }}%"></div>
                <div class="day-bar-label">{{ dlabel }}</div>
              </div>
            {% endfor %}
          </div>
        {% else %}
          <div class="error">No data</div>
        {% endif %}
      </div>
    </div>

    <div class="footer">
      Panasonic MirAIe &middot; Device: 36ff8e5467b2 &middot; Auto-refresh: {{ extension.interval | default: 15 }} min
    </div>
  </div>
</body>
</html>