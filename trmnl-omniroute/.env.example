# OmniRoute environment overrides for Umbrel.
#
# Copy this file to `.env` (in the same directory as docker-compose.yml) and
# edit the values. The `web` service loads this file via `env_file: .env`, so
# ANY OmniRoute variable documented upstream (.env.example in the OmniRoute
# repo) can be set here and will reach the container — not just the port/Redis
# vars below. Any variable left unset falls back to the inline `${VAR:-default}`
# defaults defined in docker-compose.yml (or OmniRoute's built-in defaults).
#
# Commonly needed overrides (uncomment as required):
#
#   # Allow self-hosted/local providers (Ollama, LM Studio, vLLM, etc.)
#   OMNIROUTE_ALLOW_PRIVATE_PROVIDER_URLS=true
#
#   # Initial dashboard admin password (default CHANGEME — change on first login)
#   INITIAL_PASSWORD=changeme
#
#   # Require an API key for all /v1/* proxy calls (multi-user/public deploys)
#   REQUIRE_API_KEY=false
#
#   # Allow all cross-origin browser clients to call the API
#   CORS_ALLOW_ALL=false

# --- Web server ---------------------------------------------------------------
# Dashboard port
PORT=20128
DASHBOARD_PORT=20128

# API port
API_PORT=20129
API_HOST=0.0.0.0

# WebSocket port
LIVE_WS_PORT=20132
LIVE_WS_HOST=0.0.0.0

# Allowed origins for WebSocket connections (default * allows Umbrel proxy and IPs)
LIVE_WS_ALLOWED_ORIGINS=*

# --- Redis --------------------------------------------------------------------
REDIS_URL=redis://redis:6379
