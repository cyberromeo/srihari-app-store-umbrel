# LaraPaper environment overrides for Umbrel.
#
# Copy this file to `.env` (next to docker-compose.yml) and edit. Any variable
# left unset here falls back to the inline `${VAR:-default}` defaults defined in
# docker-compose.yml.
#
# IMPORTANT: APP_KEY should be unique per install. Generate your own with:
#   echo "base64:$(openssl rand -base64 32)"
# and set it below. The default key committed in docker-compose.yml is valid but
# shared across installs — fine for trying it out, not for permanent use.

# --- Laravel app --------------------------------------------------------------
# Unique per install. Format: base64: + 32 random bytes base64-encoded.
APP_KEY=base64:bq5Ga3qOCwqTOA5h0f+xlBfVHPbNg8ku71S4p2VMsuY=

# Public URL of the app behind the Umbrel proxy (set to your Umbrel IP).
APP_URL=http://127.0.0.1:8080
APP_TIMEZONE=UTC

# --- Registration -------------------------------------------------------------
# 1 = allow new user signups via the web UI (set to 0 after first admin login).
REGISTRATION_ENABLED=1