# Cronicle environment overrides for Umbrel.
#
# Copy this file to `.env` (next to docker-compose.yml) and edit.

# Docker image version tag (defaults to latest).
# Available versions: latest, 0.9.80, 0.9.16, 0.9.11, 0.9.9, 0.8.62
CRONICLE_VERSION=latest

# Timezone for the container (defaults to Asia/Kolkata — Indian Standard Time).
TZ=Asia/Kolkata
